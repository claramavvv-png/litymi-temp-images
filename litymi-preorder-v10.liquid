var MSG={};
var S={colour:'cream',view:'front',card:{}};
ITEMS.forEach(function(it){S.card[it.id]={col:'cream',side:'front',size:it.sizes[1],len:'Knee'};});
var $=function(id){return document.getElementById(id);};
var esc=function(s){return String(s).replace(/"/g,'&quot;');};
function pill(label,on,attrs,extra){return '<button type="button" class="pill'+(extra||'')+'" aria-pressed="'+on+'" '+attrs+'>'+label+'</button>';}
function dot(c){return '<span class="dot" style="background:'+(c==='cream'?'#E3D9C6':'#111')+'"></span>';}
var CH='<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="%P" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
function renderTop(){
 var allC=ITEMS.every(function(i){return S.card[i.id].col===S.colour;});
 $('g-colour').innerHTML=['cream','black'].map(function(c){return pill(dot(c)+c.toUpperCase(),allC&&S.colour===c,'data-act="allcol" data-v="'+c+'"',' big');}).join('');
 var allS=ITEMS.every(function(i){return S.card[i.id].side===S.view;});
 $('g-view').innerHTML=['front','back'].map(function(v){return pill(v.toUpperCase(),allS&&S.view===v,'data-act="allview" data-v="'+v+'"',' big');}).join('');
}
function renderGrid(){
 var h=ITEMS.map(function(it){var c=S.card[it.id],dark=c.col==='cream';
  var opts='<div class="opt"><div class="optl">COLOUR</div><div class="pills">'+['cream','black'].map(function(k){return pill(dot(k)+k[0].toUpperCase()+k.slice(1),c.col===k,'data-act="col" data-id="'+it.id+'" data-v="'+k+'"');}).join('')+'</div></div>'
  +'<div class="opt"><div class="optl">SIZE</div><div class="pills">'+it.sizes.map(function(s){return pill(s,c.size===s,'data-act="size" data-id="'+it.id+'" data-v="'+s+'"');}).join('')+'</div></div>';
  if(it.lengths)opts+='<div class="opt"><div class="optl">LENGTH</div><div class="pills">'+it.lengths.map(function(s){return pill(s,c.len===s,'data-act="len" data-id="'+it.id+'" data-v="'+s+'"');}).join('')+'</div></div>';
  return '<div class="card"><div class="media '+(dark?'on-dark':'on-light')+'"><div class="tag">PREORDER</div>'
  +'<img src="'+img(c.col+'-'+it.id+'-'+c.side)+'" alt="'+esc((dark?'Cream ':'Black ')+it.name+', '+c.side+' view')+'" decoding="async">'
  +'<button type="button" class="arrow l" aria-label="Show front view" data-act="side" data-id="'+it.id+'" data-v="front"'+(c.side==='front'?' disabled':'')+'>'+CH.replace('%P','M11 3 L5 9 L11 15')+'</button>'
  +'<button type="button" class="arrow r" aria-label="Show back view" data-act="side" data-id="'+it.id+'" data-v="back"'+(c.side==='back'?' disabled':'')+'>'+CH.replace('%P','M7 3 L13 9 L7 15')+'</button>'
  +'<div class="vl">'+c.side.toUpperCase()+'</div></div>'
  +'<div class="body"><div><div class="row1"><div class="pname">'+it.name+'</div><div class="price">A$'+it.price+'</div></div><div class="desc">'+it.desc+'</div></div>'+opts
  +'<div class="cta"><button type="button" class="btn dark" data-act="add" data-id="'+it.id+'">ADD TO PREORDER</button><div class="msg" aria-live="polite">'+(MSG[it.id]||'')+'</div></div></div></div>';}).join('');
 h+='<div class="callout"><svg width="30" height="30" viewBox="0 0 34 34" aria-hidden="true"><path d="M17 0 L20 14 L34 17 L20 20 L17 34 L14 20 L0 17 L14 14 Z" fill="#D9B99B"/></svg><div class="big">Buy more, save more</div><p>2 pieces save 10%. 3 or more save 15%. Applied automatically at checkout.</p><a class="btn" href="#deals">SEE THE DEALS</a></div>';
 $('grid').innerHTML=h;
}
var money=function(c){return 'A$'+(c/100).toFixed(2);};
var h=function(x){return String(x).replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m];});};
function api(u,o){return fetch(u,o).then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.description||d.message||'Error');return d;});});}
var CART=null;
function loadCart(){return api('/cart.js').then(function(c){CART=c;renderCart();return c;});}
function openBag(){$('dr').classList.add('on');$('ov').classList.add('on');$('dr').setAttribute('aria-hidden','false');document.body.style.overflow='hidden';}
function closeBag(){$('dr').classList.remove('on');$('ov').classList.remove('on');$('dr').setAttribute('aria-hidden','true');document.body.style.overflow='';}
function renderCart(){
 var c=CART||{items:[],item_count:0};$('bagN').textContent=c.item_count;
 if(!c.items.length){$('drb').innerHTML='<div class="empty">Your bag is empty.</div>';$('drf').innerHTML='<a class="btn" href="#shop" data-act="closebag">KEEP SHOPPING</a>';return;}
 $('drb').innerHTML=c.items.map(function(i){var img=i.featured_image&&i.featured_image.url?'<img src="'+h(i.featured_image.url)+'" alt="">':'';
  var price=i.original_line_price!==i.final_line_price?'<s>'+money(i.original_line_price)+'</s>'+money(i.final_line_price):money(i.final_line_price);
  return '<div class="li">'+img+'<div style="flex:1;min-width:0"><div class="t">'+h(i.product_title)+'</div><div class="v">'+h(i.variant_title||'')+'</div><div class="r"><div class="q"><button type="button" aria-label="Fewer" data-act="qty" data-key="'+h(i.key)+'" data-q="'+(i.quantity-1)+'">&minus;</button><span>'+i.quantity+'</span><button type="button" aria-label="More" data-act="qty" data-key="'+h(i.key)+'" data-q="'+(i.quantity+1)+'">+</button></div><div>'+price+'</div></div></div></div>';}).join('');
 var n=c.item_count,tip=n===1?'Add 1 more piece to save 10%':n===2?'10% off applied. Add 1 more piece for 15% off.':'15% off applied.';
 var disc=c.total_discount>0?'<div class="row"><span>Discount</span><span>&minus;'+money(c.total_discount)+'</span></div>':'';
 $('drf').innerHTML='<div class="tip">'+tip+'</div><div class="row"><span>Subtotal</span><span>'+money(c.original_total_price)+'</span></div>'+disc+'<div class="row tot"><span>Total</span><span>'+money(c.total_price)+'</span></div><div style="font-size:15px;color:#6B5A44;text-align:center">Shipping calculated at checkout. Free over A$150.</div><a class="btn" href="/checkout">CHECKOUT</a>';
}
function item(id){return ITEMS.filter(function(i){return i.id===id;})[0];}
function setMsg(id,t){MSG[id]=t;renderGrid();}
function addItem(id){
 var it=item(id),c=S.card[id],title=[c.col==='cream'?'Cream':'Black',c.size].concat(it.lengths?[c.len]:[]).join(' / ');
 setMsg(id,'Adding...');
 api('/products/'+it.handle+'.js').then(function(p){var v=p.variants.filter(function(x){return x.title===title;})[0];if(!v)throw new Error('missing');
  return api('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:v.id,quantity:1}]})});})
 .then(loadCart).then(function(){setMsg(id,'Added to your bag');openBag();setTimeout(function(){if(MSG[id]==='Added to your bag')setMsg(id,'');},2500);})
 .catch(function(){setMsg(id,'Could not add this one. Please try again.');});
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeBag();});
document.querySelector('.lt').addEventListener('click',function(e){
 var b=e.target.closest('[data-act]');if(!b)return;var a=b.getAttribute('data-act'),v=b.getAttribute('data-v'),id=b.getAttribute('data-id');
 if(a==='openbag'){openBag();return;}
 if(a==='closebag'){closeBag();return;}
 if(a==='add'){addItem(id);return;}
 if(a==='qty'){api('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:b.getAttribute('data-key'),quantity:parseInt(b.getAttribute('data-q'),10)})}).then(function(c){CART=c;renderCart();});return;}
 if(a==='allcol'){S.colour=v;ITEMS.forEach(function(i){S.card[i.id].col=v;});}
 else if(a==='allview'){S.view=v;ITEMS.forEach(function(i){S.card[i.id].side=v;});}
 else if(a==='col')S.card[id].col=v;else if(a==='side')S.card[id].side=v;else if(a==='size')S.card[id].size=v;else if(a==='len')S.card[id].len=v;
 else return;
 renderTop();renderGrid();
});
renderTop();renderGrid();loadCart().catch(function(){});
// preload every image so colour and front/back swaps never flash
setTimeout(function(){ITEMS.forEach(function(i){['cream','black'].forEach(function(c){['front','back'].forEach(function(s){(new Image()).src=img(c+'-'+i.id+'-'+s);});});});},800);
})();
</script>

