  +'<div class="body"><div><div class="row1"><div class="pname">'+it.name+'</div><div class="price">A$'+it.price+'</div></div><div class="desc">'+it.desc+'</div></div>'+opts
  +'<div class="cta"><a class="btn dark" href="/products/'+it.handle+'">ADD TO PREORDER</a></div></div></div>';}).join('');
 h+='<div class="callout"><svg width="30" height="30" viewBox="0 0 34 34" aria-hidden="true"><path d="M17 0 L20 14 L34 17 L20 20 L17 34 L14 20 L0 17 L14 14 Z" fill="#D9B99B"/></svg><div class="big">Get it as a set</div><p>Pair any top with shorts or the wide-leg pants and save on the set.</p><a class="btn" href="#sets">BUILD YOUR SET</a></div>';
 $('grid').innerHTML=h;
}
function by(id){return ITEMS.filter(function(i){return i.id===id;})[0];}
function renderSet(){
 var tops=ITEMS.filter(function(i){return i.part==='top';}),bots=ITEMS.filter(function(i){return i.part==='bottom';});
 var T=by(S.setTop),B=by(S.setBottom),dark=S.setColour==='cream';
 $('s-top').innerHTML=tops.map(function(i){return pill(i.name,S.setTop===i.id,'data-act="stop" data-v="'+i.id+'"');}).join('');
 $('s-bottom').innerHTML=bots.map(function(i){return pill(i.name,S.setBottom===i.id,'data-act="sbot" data-v="'+i.id+'"');}).join('');
 $('s-colour').innerHTML=['cream','black'].map(function(c){return pill(c.toUpperCase(),S.setColour===c,'data-act="scol" data-v="'+c+'"');}).join('');
 $('s-view').innerHTML=['front','back'].map(function(v){return pill(v[0].toUpperCase()+v.slice(1),S.setView===v,'data-act="sview" data-v="'+v+'"');}).join('');
 $('s-topsize').innerHTML=T.sizes.map(function(s){return pill(s,S.setTopSize===s,'data-act="stsize" data-v="'+s+'"');}).join('');
 $('s-bottomsize').innerHTML=B.sizes.map(function(s){return pill(s,S.setBottomSize===s,'data-act="sbsize" data-v="'+s+'"');}).join('');
 $('s-len').innerHTML=['Knee','Short'].map(function(s){return pill(s,S.setLen===s,'data-act="slen" data-v="'+s+'"');}).join('');
 $('lenrow').style.display=B.lengths?'':'none';
 $('bottomLabel').textContent=B.name;
 $('setprev').style.background=dark?'#26221E':'#F2EBDD';
 $('setTop').src=img(S.setColour+'-'+T.id+'-'+S.setView);$('setTop').alt=T.name+', '+S.setView+' view';
 $('setBottom').src=img(S.setColour+'-'+B.id+'-'+S.setView);$('setBottom').alt=B.name+', '+S.setView+' view';
 $('setPrice').textContent='A$'+(T.price+B.price-SAVE);$('setSave').textContent='Save A$'+SAVE+' compared with buying separately';
 var v=$('setView');v.textContent=S.setView.toUpperCase();v.style.color=dark?'#B9AD99':'#6B5A44';
 $('sum').textContent=T.name+' + '+B.name+' · '+(dark?'Cream':'Black')+' · Top '+S.setTopSize+' · '+B.name+' '+S.setBottomSize+(B.lengths?', '+S.setLen.toLowerCase()+' length':'');
}
function fixSizes(){var T=by(S.setTop),B=by(S.setBottom);if(T.sizes.indexOf(S.setTopSize)<0)S.setTopSize=T.sizes[1];if(B.sizes.indexOf(S.setBottomSize)<0)S.setBottomSize=B.sizes[1];}
document.querySelector('.lt').addEventListener('click',function(e){
 var b=e.target.closest('[data-act]');if(!b)return;var a=b.getAttribute('data-act'),v=b.getAttribute('data-v'),id=b.getAttribute('data-id');
 if(a==='allcol'){S.colour=v;ITEMS.forEach(function(i){S.card[i.id].col=v;});S.setColour=v;}
 else if(a==='allview'){S.view=v;ITEMS.forEach(function(i){S.card[i.id].side=v;});S.setView=v;}
 else if(a==='col')S.card[id].col=v;else if(a==='side')S.card[id].side=v;else if(a==='size')S.card[id].size=v;else if(a==='len')S.card[id].len=v;
 else if(a==='stop'){S.setTop=v;fixSizes();}else if(a==='sbot'){S.setBottom=v;fixSizes();}
 else if(a==='scol')S.setColour=v;else if(a==='sview')S.setView=v;else if(a==='stsize')S.setTopSize=v;else if(a==='sbsize')S.setBottomSize=v;else if(a==='slen')S.setLen=v;
 else return;
 renderTop();renderGrid();renderSet();
});
renderTop();renderGrid();renderSet();
// preload every image so colour and front/back swaps never flash
setTimeout(function(){ITEMS.forEach(function(i){['cream','black'].forEach(function(c){['front','back'].forEach(function(s){(new Image()).src=img(c+'-'+i.id+'-'+s);});});});},800);
})();
</script>

